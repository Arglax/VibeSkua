+        );
+        gl.viewport(0, 0, width, height);
+        self.set_stencil_state();
+        gl.stencil_mask(0xff);
+        gl.clear_color(0.0, 0.0, 0.0, 0.0);
+        if msaa.is_some() {
+            gl.clear(Gl::COLOR_BUFFER_BIT | Gl::STENCIL_BUFFER_BIT);
+            self.render_bitmap(
+                handle.clone(),
