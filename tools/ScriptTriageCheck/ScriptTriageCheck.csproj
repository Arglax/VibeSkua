<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs MVS's script triage (MoVibeSkua.Android/Diagnostics/ScriptVerdicts.cs) on real compile errors and
       real script crashes: each case in cases/ is compiled the way Skua does (assembly "<Class>.cs") and run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <Compile Remove="cases\**" />
    <Compile Include="..\..\MoVibeSkua.Android\Diagnostics\ScriptVerdicts.cs" Link="ScriptVerdicts.cs" />
    <ProjectReference Include="..\..\Skua.Core.Models\Skua.Core.Models.csproj" />
    <ProjectReference Include="..\..\Skua.Core.Interfaces\Skua.Core.Interfaces.csproj" />
  </ItemGroup>
</Project>
