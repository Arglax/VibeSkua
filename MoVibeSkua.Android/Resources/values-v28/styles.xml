<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same theme, but the window also covers the camera cutout's strip. Without this Android keeps
         the window out of it, and the shell's safe-area margin then leaves the cutout space twice. -->
    <style name="MyTheme.NoActionBar" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#111318</item>
        <item name="android:navigationBarColor">#111318</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
