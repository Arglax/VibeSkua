<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             x:Class="MoVibeSkua.Android.Views.BotOptionsView"
             x:DataType="vm:BotOptionsViewModel">
    <UserControl.Styles>
        <Style Selector="Expander.bo-section">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.bo-note">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- One scrolling page; each section folds away with a tap on its header. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <Expander Classes="bo-section" IsExpanded="True">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoFix" Width="20" Height="20" Foreground="#E8C15A" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Auto Enhance" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="#D9AE52" BorderBrush="#FFE9A8" BorderThickness="1" CornerRadius="4" Padding="4,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="MVS" FontSize="10" FontWeight="Bold" Foreground="#1A140E" />
                        </Border>
                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding AutoEnhance}" OnContent="" OffContent="" VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10">
                    <TextBlock Classes="bo-note"
                               Text="Before each script, checks the enhancements on what you wear against the recommended set for your class, and fixes them. A wrong helm or cape is always fixed (they swing your HP and utility the most); the rest when less than 60% of the set matches. Spends gold; tells you if something is still locked or too expensive." />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Use case" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding UseCases}" SelectedItem="{Binding UseCase}" />
                    </Grid>
                    <TextBlock Classes="bo-note" Text="{Binding UseCaseNote}" />

                    <TextBlock Text="Pieces it may change" FontWeight="SemiBold" />
                    <UniformGrid Columns="2">
                        <CheckBox Content="Class" IsChecked="{Binding SlotClass}" IsEnabled="{Binding CanTickClass}" />
                        <CheckBox Content="Weapon" IsChecked="{Binding SlotWeapon}" IsEnabled="{Binding CanTickWeapon}" />
                        <CheckBox Content="Helm" IsChecked="{Binding SlotHelm}" IsEnabled="{Binding CanTickHelm}" />
                        <CheckBox Content="Cape" IsChecked="{Binding SlotCape}" IsEnabled="{Binding CanTickCape}" />
                    </UniformGrid>
                    <TextBlock Classes="bo-note" Text="{Binding SlotsNote}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Classes="skua-button skua-primary" Command="{Binding CheckNowCommand}" IsEnabled="{Binding !IsChecking}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ShieldCheck" Width="16" Height="16" />
                                <TextBlock Text="Check now" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Classes="bo-section" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="20" Height="20" Foreground="#E8C15A" VerticalAlignment="Center" />
                        <TextBlock Text="Game options" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <ContentControl Content="{Binding GameOptions}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
