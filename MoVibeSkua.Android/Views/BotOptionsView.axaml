<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             x:Class="MoVibeSkua.Android.Views.BotOptionsView"
             x:DataType="vm:BotOptionsViewModel">
    <UserControl.Styles>
        <Style Selector="Expander.bo-section">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.bo-note">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.bo-bullet">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.ube-row">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Styles>

    <!-- One scrolling page; each section folds away with a tap on its header. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <Expander Classes="bo-section" IsExpanded="True">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoFix" Width="20" Height="20" Foreground="#E8C15A" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Use Best Enhancement" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="#D9AE52" BorderBrush="#FFE9A8" BorderThickness="1" CornerRadius="4" Padding="4,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="MVS" FontSize="10" FontWeight="Bold" Foreground="#1A140E" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="Before each script" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        <ToggleSwitch Grid.Column="4" IsChecked="{Binding AutoEnhance}" OnContent="" OffContent="" VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="bo-bullet" Text="• This is a script that puts the best enhancements for your class on your gear." />
                        <TextBlock Classes="bo-bullet" Text="• &quot;Best&quot; comes from the Skua script team's SmartEnhance list (Auto-Users-Quest-Worlds, the same list their scripts use), and for Ultra bosses from the r/AQW Simplified Bosses Guide." />
                        <TextBlock Classes="bo-bullet" Text="• The recommended enhancement for each item is shown below; tick the ones you want enhanced." />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="For" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        <ListBox Grid.Column="1" Classes="segmented" ItemsSource="{Binding UseCases}" SelectedItem="{Binding UseCase}" />
                        <Button Grid.Column="3" Classes="skua-button" Command="{Binding ReadGearCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                                <TextBlock Text="Read my gear" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Classes="bo-note" Text="{Binding ReadInfo}" />

                    <!-- Piece | now | best | status, one card per piece -->
                    <Grid ColumnDefinitions="40,1.3*,*,*,1.1*" Margin="8,0">
                        <TextBlock Grid.Column="1" Text="Item" Classes="bo-note" />
                        <TextBlock Grid.Column="2" Text="Now" Classes="bo-note" />
                        <TextBlock Grid.Column="3" Text="Best" Classes="bo-note" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GearRowViewModel">
                                <Border Classes="ube-row">
                                    <Grid ColumnDefinitions="40,1.3*,*,*,1.1*" ColumnSpacing="6">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Ticked}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Item}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Now}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{Binding BestText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                                        <TextBlock Grid.Column="4" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="{Binding StatusColor}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Classes="skua-button skua-primary" Command="{Binding EnhanceNowCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ShieldCheck" Width="16" Height="16" />
                                <TextBlock Text="Enhance ticked items now" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Classes="bo-note" Text="{Binding ToChange}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="bo-note" Text="{Binding LastResult}" />
                </StackPanel>
            </Expander>

            <Expander Classes="bo-section" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="20" Height="20" Foreground="#E8C15A" VerticalAlignment="Center" />
                        <TextBlock Text="Game options" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <ContentControl Content="{Binding GameOptions}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
