<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             x:Class="MoVibeSkua.Android.Views.BotOptionsView"
             x:DataType="vm:BotOptionsViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- MVS's own bot settings, first. -->
        <Border Grid.Row="0" Margin="12,12,12,0" Padding="12" CornerRadius="12"
                Background="{DynamicResource SkuaSurfaceAltBrush}" BorderBrush="#8A6A2E" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoFix" Width="22" Height="22" Foreground="#E8C15A" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Auto Enhance" FontWeight="SemiBold" FontSize="16" />
                        <Border Background="#D9AE52" BorderBrush="#FFE9A8" BorderThickness="1" CornerRadius="4" Padding="4,0" VerticalAlignment="Center">
                            <TextBlock Text="MVS" FontSize="10" FontWeight="Bold" Foreground="#1A140E" />
                        </Border>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoEnhance}" OnContent="" OffContent="" />
                </Grid>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SkuaMutedTextBrush}"
                           Text="Before each script, checks the class, weapon, helm and cape you're wearing against the recommended enhancements for your class. A wrong helm or cape is always fixed (they matter most); the rest is redone when less than 60% of the set matches. Spends gold; tells you if something is still locked or too expensive." />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="Use case" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding UseCases}" SelectedItem="{Binding UseCase}" />
                </Grid>
                <TextBlock Text="{Binding UseCaseNote}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Classes="skua-button skua-primary" Command="{Binding CheckNowCommand}" IsEnabled="{Binding !IsChecking}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ShieldCheck" Width="16" Height="16" />
                            <TextBlock Text="Check now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding GameOptions}" />
    </Grid>
</UserControl>
