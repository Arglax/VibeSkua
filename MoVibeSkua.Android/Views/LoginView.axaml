<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             xmlns:platform="clr-namespace:MoVibeSkua.Android.Platform"
             x:Class="MoVibeSkua.Android.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="10" MaxWidth="480">

            <!-- Saved accounts: one tap logs in with that account's server. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasAccounts}">
                <TextBlock Text="Quick login" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="platform:SavedAccount">
                            <Border Margin="0,3" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="skua-button skua-primary" Content="Log in"
                                            Command="{Binding $parent[UserControl].((vm:LoginViewModel)DataContext).QuickLoginCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="2" Classes="skua-button" ToolTip.Tip="Edit"
                                            Command="{Binding $parent[UserControl].((vm:LoginViewModel)DataContext).EditAccountCommand}"
                                            CommandParameter="{Binding}">
                                        <materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="skua-button" ToolTip.Tip="Remove from this device"
                                            Command="{Binding $parent[UserControl].((vm:LoginViewModel)DataContext).RemoveAccountCommand}"
                                            CommandParameter="{Binding}">
                                        <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="Log in with your AQW account. MVS keeps you logged in and relogs after disconnects. Saved accounts stay on this device only, encrypted with the phone's keystore."
                       TextWrapping="Wrap" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <!-- No auto-capitals, autocorrect or suggestions: the hidden password used to get its first
                 letter capitalised or a word swapped by the keyboard, so AQW rejected a correct login. -->
            <TextBox Text="{Binding Username}" Watermark="Username"
                     TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding Password}" Watermark="Password" PasswordChar="•"
                         RevealPassword="{Binding #ShowPassword.IsChecked}"
                         TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True"
                         TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" />
                <ToggleButton x:Name="ShowPassword" Grid.Column="1" Classes="skua-button" ToolTip.Tip="Show password">
                    <Panel>
                        <materialIcons:MaterialIcon Kind="EyeOutline" Width="18" Height="18" IsVisible="{Binding !#ShowPassword.IsChecked}" />
                        <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="18" Height="18" IsVisible="{Binding #ShowPassword.IsChecked}" />
                    </Panel>
                </ToggleButton>
            </Grid>
            <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding Server}" HorizontalAlignment="Stretch"
                      PlaceholderText="Server" />
            <CheckBox IsChecked="{Binding Remember}" Content="Save this account on this device when I log in" />
            <Grid ColumnDefinitions="*,8,*,8,*">
                <Button Grid.Column="0" Classes="skua-button skua-primary" HorizontalAlignment="Stretch"
                        Content="Log in" Command="{Binding LoginCommand}" IsVisible="{Binding !IsBusy}" />
                <Button Grid.Column="0" Classes="skua-button" HorizontalAlignment="Stretch"
                        Content="Cancel" Command="{Binding CancelLoginCommand}" IsVisible="{Binding IsBusy}" />
                <Button Grid.Column="2" Classes="skua-button" HorizontalAlignment="Stretch"
                        Content="Save account" Command="{Binding SaveAccountCommand}" />
                <Button Grid.Column="4" Classes="skua-button" HorizontalAlignment="Stretch"
                        Content="Log out" Command="{Binding LogoutCommand}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
