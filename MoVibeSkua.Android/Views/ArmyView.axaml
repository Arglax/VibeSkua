<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             x:Class="MoVibeSkua.Android.Views.ArmyView"
             x:DataType="vm:ArmyViewModel">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="10">
            <Border Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="1"
                    Padding="12"
                    CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ThisClient}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MemoryText}" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="skua-button" VerticalAlignment="Center"
                                Command="{Binding OpenButlerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="AccountSupervisorOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Butler" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="skua-button skua-primary" VerticalAlignment="Center"
                                IsEnabled="{Binding CanAdd}" Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="AccountPlus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Add client" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SkuaMutedTextBrush}"
                               Text="Each client is its own game with its own login, like a separate MVS window on PC. Only the client on screen draws the game; the others keep playing and botting without drawing anything, and stay silent. Army scripts sync through the shared MVS folder, as on PC. Switch here or from the recent-apps screen." />
                    <TextBlock Text="{Binding Warning}" FontSize="11" TextWrapping="Wrap" Foreground="#F7C948"
                               IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SkuaMutedTextBrush}"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Clients}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArmyClientItem">
                        <Border Margin="0,3" Padding="10,6,4,6" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource SkuaSurfaceBrush}"
                                BorderBrush="{DynamicResource SkuaBorderBrush}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Background="#7A1717" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                IsVisible="{Binding IsThis}">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#F7C948" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" VerticalAlignment="Center"
                                                                    Foreground="#4E9E36" IsVisible="{Binding IsScriptRunning}" />
                                        <TextBlock Text="{Binding ScriptText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="skua-button skua-primary" VerticalAlignment="Center"
                                        IsVisible="{Binding CanSwitch}"
                                        Command="{Binding $parent[ItemsControl].((vm:ArmyViewModel)DataContext).SwitchToCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="15" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="Switch" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="mobile-icon" VerticalAlignment="Center"
                                        IsVisible="{Binding CanClose}"
                                        Command="{Binding $parent[ItemsControl].((vm:ArmyViewModel)DataContext).CloseCommand}"
                                        CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="Close" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
