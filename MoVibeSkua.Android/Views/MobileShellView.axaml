<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:MoVibeSkua.Android.Controls"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             xmlns:appVm="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:appUc="clr-namespace:Skua.App.Avalonia.UserControls"
             x:Class="MoVibeSkua.Android.Views.MobileShellView"
             x:DataType="vm:ShellViewModel"
             TopLevel.AutoSafeAreaPadding="False"
             Background="{DynamicResource SkuaPageBrush}">
    <!-- AutoSafeAreaPadding off: ApplyInsets in code-behind handles the cutout and system bars, and
         Avalonia's own padding on top of it left the cutout's width empty twice. -->

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:RailAction">
            <Button Classes="mobile-rail" Classes.active="{Binding IsActive}" Command="{Binding Command}">
                <StackPanel Spacing="1">
                    <Panel Height="30" HorizontalAlignment="Center">
                        <Image Source="{Binding Image}" Width="30" Height="30" IsVisible="{Binding HasImage}" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" IsVisible="{Binding !HasImage}" />
                        <!-- Count (Drops waiting), on the icon's top-right corner. -->
                        <Border IsVisible="{Binding HasBadge}" Background="#C42820" BorderBrush="#FFD678" BorderThickness="1"
                                CornerRadius="8" MinWidth="16" Height="16" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-10,0">
                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                    <TextBlock Text="{Binding Label}" Classes="mobile-rail-label" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <!-- Desktop shows Auto as a fixed 360px card; scale it down to fit a narrow panel's width only.
             Inside the scroller its height is unlimited, so a long monster list scrolls instead of
             shrinking the whole card. -->
        <DataTemplate x:DataType="appVm:AutoViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="8">
                    <appUc:AutoUserControl />
                </Viewbox>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- Rows and columns are arranged in code: rails beside the game in landscape, bars above and
         below it in portrait. -->
    <Grid x:Name="Root">

        <!-- Portrait top bar -->
        <Border x:Name="TopBar" Classes="mobile-topbar">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                <Button Grid.Column="0" Classes="mobile-icon" Command="{Binding ToggleMenuCommand}" IsVisible="{Binding IsBotMode}">
                    <materialIcons:MaterialIcon Kind="Menu" />
                </Button>
                <Button Grid.Column="1" Classes="mobile-icon" Command="{Binding BackCommand}" IsVisible="{Binding HasPreviousPage}">
                    <materialIcons:MaterialIcon Kind="ArrowLeft" />
                </Button>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                    <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="3" Classes="mobile-icon" Command="{Binding CloseAllPagesCommand}" IsVisible="{Binding HasPage}">
                    <materialIcons:MaterialIcon Kind="Close" />
                </Button>
                <Button Grid.Column="4" Classes="skua-button skua-primary mobile-script" Content="{Binding ToggleScriptText}" Command="{Binding ToggleScriptCommand}" IsVisible="{Binding IsBotMode}" />
                <Button Grid.Column="5" Classes="mobile-icon" Command="{Binding ToggleGameMaximizedCommand}">
                    <materialIcons:MaterialIcon Kind="Fullscreen" />
                </Button>
                <!-- The crest, as in landscape: 1 tap Support MVS, 2 taps game buttons / bot tools. -->
                <Button Grid.Column="6" Classes="mobile-icon" Padding="2" Command="{Binding CrestTapCommand}">
                    <Image Source="avares://MoVibeSkua/Images/mvs-crest.png" Width="30" Height="30" />
                </Button>
            </Grid>
        </Border>

        <!-- Landscape left rail: the game's buttons by default; in bot mode navigation and the script
             button within thumb reach. -->
        <Border x:Name="LeftRailFrame" Classes="mobile-railframe left">
            <!-- Scaled up to fill the space the game's letterbox leaves (see UpdateRailScale). -->
            <LayoutTransformControl x:Name="LeftRailScale">
            <Grid RowDefinitions="Auto,*,Auto">
                <Button Grid.Row="0" Classes="mobile-rail" Command="{Binding ToggleMenuCommand}" IsVisible="{Binding IsBotMode}">
                    <StackPanel Spacing="1">
                        <materialIcons:MaterialIcon Kind="Menu" Width="22" Height="22" />
                        <TextBlock Text="Menu" Classes="mobile-rail-label" />
                    </StackPanel>
                </Button>
                <!-- Every button gets an equal share of the height, so the rail always fits exactly
                     and never scrolls (the user asked for no scrolling at all). -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding LeftRail}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2" Classes="mobile-rail mobile-rail-script" Classes.running="{Binding IsScriptRunning}" Command="{Binding ToggleScriptCommand}" IsVisible="{Binding IsBotMode}">
                    <StackPanel Spacing="1">
                        <Panel>
                            <materialIcons:MaterialIcon Kind="Play" Width="22" Height="22" IsVisible="{Binding !IsScriptRunning}" />
                            <materialIcons:MaterialIcon Kind="Stop" Width="22" Height="22" IsVisible="{Binding IsScriptRunning}" />
                        </Panel>
                        <!-- Short label so the button stays one rail button tall and Army fits without scrolling. -->
                        <Panel>
                            <TextBlock Text="Start" Classes="mobile-rail-label" IsVisible="{Binding !IsScriptRunning}" />
                            <TextBlock Text="Stop" Classes="mobile-rail-label" IsVisible="{Binding IsScriptRunning}" />
                        </Panel>
                    </StackPanel>
                </Button>
            </Grid>
            </LayoutTransformControl>
        </Border>

        <!-- Right rail in landscape, bottom bar in portrait: quick tools. -->
        <Border x:Name="RightRailFrame" Classes="mobile-railframe right">
            <LayoutTransformControl x:Name="RightRailScale">
            <Grid x:Name="RightRailGrid" RowDefinitions="*,Auto,Auto">
                <ScrollViewer x:Name="RightRailScroll" Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="RightRailItems" />
                </ScrollViewer>
                <!-- The MVS guide, just above the crest (game buttons only; landscape). -->
                <Panel x:Name="GuideSlot" Grid.Row="1">
                    <Button Classes="mobile-rail" Command="{Binding OpenGuideCommand}" IsVisible="{Binding !IsBotMode}">
                        <StackPanel Spacing="1">
                            <materialIcons:MaterialIcon Kind="HelpCircle" Width="22" Height="22" />
                            <TextBlock Text="Guide" Classes="mobile-rail-label" />
                        </StackPanel>
                    </Button>
                </Panel>
                <!-- The app's crest: one tap opens Support MVS, two quick taps switch the rails between the
                     game's buttons and the bot tools. -->
                <Button x:Name="MaximizeButton" Grid.Row="2" Classes="mobile-rail" Padding="2" Command="{Binding CrestTapCommand}">
                    <Image Source="avares://MoVibeSkua/Images/mvs-crest.png" Width="50" Height="50" RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Button>
            </Grid>
            </LayoutTransformControl>
        </Border>

        <SplitView x:Name="Split"
                   IsPaneOpen="{Binding IsMenuOpen}"
                   DisplayMode="Overlay"
                   OpenPaneLength="250"
                   PaneBackground="{DynamicResource SkuaSurfaceBrush}">
            <SplitView.Pane>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="16,10" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="MVS" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding MenuGroups}" Margin="0,4,0,24">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShellMenuGroup">
                                    <StackPanel Margin="0,6,0,2">
                                        <TextBlock Text="{Binding Header}" Classes="mobile-menu-header" />
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShellMenuEntry">
                                                    <Button Classes="mobile-menu-item" Content="{Binding Header}" Command="{Binding Command}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </SplitView.Pane>

            <!-- Game and the current tool page, placed in code: the page lies over the game in landscape and
                 sits below it in portrait. The two rows stay put (only their sizes change), so a hidden page
                 never points at a row that is gone. -->
            <Grid x:Name="Body" RowDefinitions="*,0">
                <Border x:Name="GameFrame" Background="Black">
                    <controls:GameView x:Name="Game" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="PageFrame" Classes="mobile-page" IsVisible="False">
                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
                        <!-- Landscape only: drag to make the page cover more or less of the game. -->
                        <Border x:Name="PageGrip" Grid.RowSpan="2" Classes="mobile-pagegrip">
                            <Border Classes="mobile-pagegrip-pill" />
                        </Border>
                        <Border x:Name="PageHeader" Grid.Row="0" Grid.Column="1" Classes="mobile-pageheader">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Button Grid.Column="0" Classes="mobile-icon" Command="{Binding BackCommand}" IsVisible="{Binding HasPreviousPage}">
                                    <materialIcons:MaterialIcon Kind="ArrowLeft" />
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="mobile-icon" Command="{Binding TogglePageWideCommand}">
                                    <Panel>
                                        <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" IsVisible="{Binding !IsPageWide}" />
                                        <materialIcons:MaterialIcon Kind="ArrowCollapseHorizontal" IsVisible="{Binding IsPageWide}" />
                                    </Panel>
                                </Button>
                                <Button Grid.Column="3" Classes="mobile-icon" Command="{Binding CloseAllPagesCommand}">
                                    <materialIcons:MaterialIcon Kind="Close" />
                                </Button>
                            </Grid>
                        </Border>
                        <!-- Page views are added and shown in code (ShowCurrentPageView), which keeps them. -->
                        <Panel x:Name="PageHost" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </Border>
            </Grid>
        </SplitView>

        <!-- Dialogs from MobileDialogService; spans the whole grid (set in code). -->
        <Panel x:Name="DialogLayer" IsVisible="False" Background="#99000000" />
    </Grid>
</UserControl>
