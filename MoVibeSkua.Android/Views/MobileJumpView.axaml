<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             xmlns:fastTravel="clr-namespace:Skua.App.Avalonia.ViewModels.FastTravel"
             xmlns:uc="clr-namespace:Skua.App.Avalonia.UserControls"
             x:Class="MoVibeSkua.Android.Views.MobileJumpView"
             x:DataType="vm:MobileJumpViewModel">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="10">
            <!-- Desktop draws the cell and pad jump as a fixed 320px card; scale it down to fit. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <uc:JumpUserControl DataContext="{Binding Jump}" />
            </Viewbox>

            <Border Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="1"
                    Padding="12"
                    CornerRadius="8">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="BookmarkOutline" Width="16" Height="16"
                                                    Foreground="{DynamicResource SkuaAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Saved Spots" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Add a map, with a room number to keep it private. Jump joins it like /join map-room in chat."
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SkuaMutedTextBrush}" />

                    <Grid ColumnDefinitions="*,72,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding NewMap}" Watermark="Map, e.g. ultraalteon" />
                        <TextBox Grid.Column="1" Text="{Binding NewRoom}" Watermark="Room" TextInputOptions.ContentType="Digits" />
                        <Button Grid.Column="2" Classes="skua-button skua-primary" Command="{Binding AddSpotCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Add" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="No saved spots yet." FontSize="12" Foreground="{DynamicResource SkuaMutedTextBrush}"
                               IsVisible="{Binding !Spots.Count}" />

                    <ItemsControl ItemsSource="{Binding Spots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fastTravel:FastTravelItemViewModel">
                                <Border Margin="0,3" Padding="10,4,4,4" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding DescriptionName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MapName}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="skua-button skua-primary" VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).TravelToCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="RunFast" Width="15" Height="15" VerticalAlignment="Center" />
                                                <TextBlock Text="Jump" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="mobile-icon"
                                                Command="{Binding $parent[ItemsControl].((vm:MobileJumpViewModel)DataContext).RemoveSpotCommand}"
                                                CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="Close" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
