<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:MoVibeSkua.Android.ViewModels"
             x:Class="MoVibeSkua.Android.Views.GraphicsView"
             x:DataType="vm:GraphicsViewModel">
    <UserControl.Styles>
        <Style Selector="Border.gfx-card">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBlock.gfx-title">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.gfx-note">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.gfx-label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8" Spacing="10">

            <Border Classes="gfx-card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Speedometer" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" />
                        <TextBlock Classes="gfx-title" Text="Presets" />
                    </StackPanel>
                    <UniformGrid Columns="2" Rows="2">
                        <Button Classes="skua-button" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Battery" Command="{Binding ApplyPresetCommand}" CommandParameter="battery" />
                        <Button Classes="skua-button" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Balanced" Command="{Binding ApplyPresetCommand}" CommandParameter="balanced" />
                        <Button Classes="skua-button" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Quality" Command="{Binding ApplyPresetCommand}" CommandParameter="quality" />
                        <Button Classes="skua-button skua-primary" Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Ultra" Command="{Binding ApplyPresetCommand}" CommandParameter="ultra" />
                    </UniformGrid>
                    <TextBlock Classes="gfx-note"
                               Text="Battery and Balanced keep fights smooth on weaker phones. Ultra draws above the screen's resolution with 8x anti-aliasing and richer colours; it needs a strong phone." />
                </StackPanel>
            </Border>

            <Border Classes="gfx-card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="MonitorScreenshot" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" />
                        <TextBlock Classes="gfx-title" Text="Graphics" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Grid.Row="0" Classes="gfx-label" Text="Resolution" />
                        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding Resolution}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphicsViewModel+Choice">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Classes="gfx-label" Text="Anti-aliasing" />
                        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AntiAliasChoices}" SelectedItem="{Binding AntiAlias}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphicsViewModel+Choice">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Classes="gfx-label" Text="Colours" />
                        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ColourChoices}" SelectedItem="{Binding ColourStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphicsViewModel+Choice">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Classes="gfx-note"
                               Text="Resolution and anti-aliasing cost the most graphics power. &quot;Game setting&quot; leaves anti-aliasing to AQW's own quality option." />
                </StackPanel>
            </Border>

            <Border Classes="gfx-card">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" />
                        <TextBlock Classes="gfx-title" Text="Performance" />
                    </StackPanel>
                    <CheckBox Content="Show game FPS" IsChecked="{Binding ShowFps}" />
                    <TextBlock Classes="gfx-note"
                               Text="AQW is made for 30 frames a second: green is 28+, yellow 20+, red below. Running it faster would speed its animations up, not smooth them." />
                    <CheckBox Content="Smooth motion (looks like 60 fps)" IsChecked="{Binding SmoothMotion}" />
                    <TextBlock Classes="gfx-note"
                               Text="The game still runs at 30 frames a second, but walking, sliding and tweened moves are also drawn halfway between frames, so they look like 60. Art that swaps from frame to frame (some attacks) stays at 30. It costs processor time, so with Auto smooth on it pauses while the phone is throttling itself (hot), or when it adds fewer than 15 pictures a second, and comes back when it pays off again." />
                    <CheckBox Content="Auto smooth (keep 30 fps)" IsChecked="{Binding AutoSmooth}" />
                    <TextBlock Classes="gfx-note"
                               Text="When the game drops below 30 fps for a few seconds, MVS first turns off Smooth motion, then lowers anti-aliasing and resolution one step at a time, and goes back to your settings when there is room. A step that does not raise the frame rate is undone." />
                    <CheckBox Content="Heat warnings" IsChecked="{Binding HeatWarnings}" />
                    <TextBlock Classes="gfx-note"
                               Text="MVS runs at full speed up to 47°C (battery temperature) and warns you from 45°C. At 47°C, or when Android reports the phone as hot, it switches to a cooler mode (lighter graphics, steadier clocks) until the phone is back under 45°C." />
                    <CheckBox Content="Lag killer (hide the whole game world; bots keep playing)" IsChecked="{Binding Options.LagKiller}" />
                    <CheckBox Content="Hide other players" IsChecked="{Binding Options.HidePlayers}" />
                    <CheckBox Content="Optimize other players" IsChecked="{Binding Options.OptimizePlayers}" />
                    <CheckBox Content="Disable skill effects" IsChecked="{Binding Options.DisableFX}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
