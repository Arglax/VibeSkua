// Generated by tools/generate_firestore_rules.py from MoVibeSkua.Android/Usage/Signal.cs; edit that, not this.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything that is not explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // Usage counts, one document per anonymous install. Nothing client-side reads them back;
    // reporting runs through the Admin SDK.
    match /movibeskua_installs/{uid} {
      allow read: if false;

      allow delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.schema == 1
        && request.resource.data.app == 'movibeskua'
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 24
        && request.resource.data.appVersionCode is int
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 7
        && request.resource.data.keys().hasOnly([
          'app',
          'appVersion',
          'appVersionCode',
          'country',
          'days',
          'features',
          'firstSeen',
          'lastSeen',
          'schema',
          'screens'
        ])
        && request.resource.data.get('features', {}).keys().hasOnly([
          'ACCOUNT_SAVED',
          'ARMY_ADD',
          'ARMY_CLIENT_START',
          'ARMY_CLOSE',
          'ARMY_FULL',
          'ARMY_LOW_MEMORY',
          'ARMY_SIZE_2',
          'ARMY_SIZE_3',
          'ARMY_SIZE_4',
          'ARMY_SIZE_5_7',
          'ARMY_SIZE_8_PLUS',
          'ARMY_SWITCH',
          'AUTO_ATTACK_START',
          'AUTO_HUNT_START',
          'GAME_KEYBOARD',
          'GAME_MAXIMIZED',
          'LOGIN_DONE',
          'LOGIN_QUICK',
          'LOGIN_REFUSED',
          'NAV_MENU',
          'NAV_RAIL',
          'PAGE_RESIZED',
          'PAGE_WIDE',
          'RELOGIN',
          'RELOGIN_KICKED',
          'SCRIPT_ERROR',
          'SCRIPT_STARTED',
          'SCRIPT_STOPPED',
          'STREAMER_OFF',
          'STREAMER_ON',
          'SYS_CRASH',
          'SYS_LAYOUT_LANDSCAPE',
          'SYS_LAYOUT_PORTRAIT',
          'SYS_RENDERER_GONE',
          'SYS_SESSION_START'
        ])
        && screensOk(request.resource.data.get('screens', {}), ['visits', 'ms', 'quick', 'idle', 'd5', 'd15', 'd60', 'd180', 'dmax'])
        && request.resource.data.get('days', {}) is map
        && request.resource.data.get('days', {}).size() <= 2000;

      function screensOk(screens, fields) {
        return screens.keys().hasOnly([
          'APP_OPTIONS',
          'ARMY',
          'AUTO',
          'CONSOLE',
          'COREBOTS',
          'CURRENT_DROPS',
          'DIAGNOSTICS',
          'FAST_TRAVEL',
          'GAME',
          'GAME_OPTIONS',
          'GRABBER',
          'JUMP',
          'JUNK_ITEMS',
          'LOADER',
          'LOADOUTS',
          'LOGIN',
          'LOGS',
          'NOTIFY_DROP',
          'OTHER',
          'PACKET_LOGGER',
          'PACKET_SPAMMER',
          'PLUGINS',
          'RUNTIME',
          'SCHEDULER',
          'SCRIPTS',
          'SCRIPT_REPO',
          'SKILLS',
          'STATS',
          'THEMES'
        ])
          && (!('APP_OPTIONS' in screens) || screens.APP_OPTIONS.keys().hasOnly(fields))
          && (!('ARMY' in screens) || screens.ARMY.keys().hasOnly(fields))
          && (!('AUTO' in screens) || screens.AUTO.keys().hasOnly(fields))
          && (!('CONSOLE' in screens) || screens.CONSOLE.keys().hasOnly(fields))
          && (!('COREBOTS' in screens) || screens.COREBOTS.keys().hasOnly(fields))
          && (!('CURRENT_DROPS' in screens) || screens.CURRENT_DROPS.keys().hasOnly(fields))
          && (!('DIAGNOSTICS' in screens) || screens.DIAGNOSTICS.keys().hasOnly(fields))
          && (!('FAST_TRAVEL' in screens) || screens.FAST_TRAVEL.keys().hasOnly(fields))
          && (!('GAME' in screens) || screens.GAME.keys().hasOnly(fields))
          && (!('GAME_OPTIONS' in screens) || screens.GAME_OPTIONS.keys().hasOnly(fields))
          && (!('GRABBER' in screens) || screens.GRABBER.keys().hasOnly(fields))
          && (!('JUMP' in screens) || screens.JUMP.keys().hasOnly(fields))
          && (!('JUNK_ITEMS' in screens) || screens.JUNK_ITEMS.keys().hasOnly(fields))
          && (!('LOADER' in screens) || screens.LOADER.keys().hasOnly(fields))
          && (!('LOADOUTS' in screens) || screens.LOADOUTS.keys().hasOnly(fields))
          && (!('LOGIN' in screens) || screens.LOGIN.keys().hasOnly(fields))
          && (!('LOGS' in screens) || screens.LOGS.keys().hasOnly(fields))
          && (!('NOTIFY_DROP' in screens) || screens.NOTIFY_DROP.keys().hasOnly(fields))
          && (!('OTHER' in screens) || screens.OTHER.keys().hasOnly(fields))
          && (!('PACKET_LOGGER' in screens) || screens.PACKET_LOGGER.keys().hasOnly(fields))
          && (!('PACKET_SPAMMER' in screens) || screens.PACKET_SPAMMER.keys().hasOnly(fields))
          && (!('PLUGINS' in screens) || screens.PLUGINS.keys().hasOnly(fields))
          && (!('RUNTIME' in screens) || screens.RUNTIME.keys().hasOnly(fields))
          && (!('SCHEDULER' in screens) || screens.SCHEDULER.keys().hasOnly(fields))
          && (!('SCRIPTS' in screens) || screens.SCRIPTS.keys().hasOnly(fields))
          && (!('SCRIPT_REPO' in screens) || screens.SCRIPT_REPO.keys().hasOnly(fields))
          && (!('SKILLS' in screens) || screens.SKILLS.keys().hasOnly(fields))
          && (!('STATS' in screens) || screens.STATS.keys().hasOnly(fields))
          && (!('THEMES' in screens) || screens.THEMES.keys().hasOnly(fields));
      }
    }

    // Problem reports for the developer (MoVibeSkua.Android/Diagnostics/ProblemReports.cs): app crashes,
    // MVS errors, scripts that stopped because of MVS, and "Report a problem". Written once by the
    // install that made them; read only through the Admin SDK (tools/aggregate_usage.py).
    match /movibeskua_reports/{id} {
      allow read, update, delete: if false;

      allow create: if request.auth != null
        && id.size() <= 60
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'category', 'summary', 'exception', 'stack', 'log',
             'script', 'signature', 'appVersion', 'device', 'android', 'client', 'time'])
        && request.resource.data.kind in ['crash', 'error', 'script', 'user']
        && request.resource.data.category == 'mvs'
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 500
        && request.resource.data.exception is string && request.resource.data.exception.size() <= 200
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 12000
        && request.resource.data.log is string && request.resource.data.log.size() <= 24000
        && request.resource.data.script is string && request.resource.data.script.size() <= 120
        && request.resource.data.signature is string && request.resource.data.signature.size() <= 32
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 40
        && request.resource.data.device is string && request.resource.data.device.size() <= 80
        && request.resource.data.android is string && request.resource.data.android.size() <= 20
        && request.resource.data.client is int
        && request.resource.data.time is timestamp;
    }
  }
}
